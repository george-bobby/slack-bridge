# ─── Secrets and machine-specific configuration ──────────────────────────────
# Every Slack member id, Linear slug and absolute path lives here. .env.example
# is the committed documentation for it.
.env
.env.local
.env.*.local

# ─── Generated prompts ───────────────────────────────────────────────────────
# scripts/install.sh renders templates/ into .claude/skills/ with this
# machine's .env baked in, then symlinks the result into ~/.claude. The
# templates are source; these are build output.
.claude/commands/
.claude/skills/

# ─── Runtime state ───────────────────────────────────────────────────────────
# Everything the dashboard writes: config.json and runs/ (chat transcripts,
# which contain Slack message text, plus plans and memory proposals). One
# rule, one directory; the committed example is the sole exception.
data/*
!data/config.example.json

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
package-lock.json

# ─── Editors and OS ──────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*~

# Your own copies of templates/ (e.g. a repo-specific skill). Rendered in
# preference to templates/ and never committed.
templates.local/
