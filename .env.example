# slack-bridge config. Copy to .env, fill in, then run ./scripts/install.sh start.
# A real environment variable overrides any value here.

# You
SLACK_USER_ID=U00000000000            # Slack profile > ⋮ > Copy member ID
SLACK_USER_NAME="Your Name"
GITHUB_LOGIN=your-github-login        # account gh pushes and opens PRs as
GITHUB_REPO=your-org/your-repo        # where PRs are opened

# Repo
TARGET_REPO=/Users/you/Development/your-repo
TARGET_SCOPE=                         # optional subdirectory to stay inside
WORKTREE_ROOT=                        # default: <TARGET_REPO>-worktrees
BRANCH_PREFIX=                        # default: GITHUB_LOGIN

# Product
PRODUCT_NAME="Your Product"
PRODUCT_URL=app.example.com

# Linear
LINEAR_WORKSPACE=your-workspace
LINEAR_TEAM="Your Team"
LINEAR_ISSUE_PREFIX=ABC
LINEAR_PROJECT=                       # optional

# Ticket hints, as Name:MemberID,Name:MemberID (optional)
SLACK_PRODUCT_TEAM=
SLACK_ENGINEER_TEAM=

# Runtime
SLACK_BRIDGE_PORT=4319
LAUNCHD_LABEL=local.slack-bridge
PIPELINE_MODEL=opus
EXTRA_PATH=                           # dirs holding claude and uvx (launchd's PATH has neither)
TERMINAL_APP=Terminal                 # Terminal or iTerm
