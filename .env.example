# slack-bridge configuration
#
#   cp .env.example .env   &&   edit   &&   ./install.sh
#
# Everything specific to one person's Slack workspace, Linear team and repo
# lives here. `.env` is gitignored; this file is the documentation.
#
# The prompts in `templates/` are rendered from these values by `./install.sh`,
# so changing anything below means re-running `./install.sh` to regenerate
# `.claude/`. A real environment variable always beats a line in `.env`.


# ─── Who we watch for ────────────────────────────────────────────────────────

# Required. The Slack member id whose @mentions the poller searches for.
# Find it: Slack profile → ⋮ → "Copy member ID".
SLACK_USER_ID=U00000000000

# Display name, used in the prompts ("a Slack @mention of <name>").
SLACK_USER_NAME=Your Name

# The GitHub account `gh` pushes and assigns PRs with.
GITHUB_LOGIN=your-github-login


# ─── What the pipeline works on ──────────────────────────────────────────────

# Absolute path to the repo the pipeline builds against. This is also the
# default working directory for follow-up sessions started from the dashboard.
TARGET_REPO=/Users/you/Development/your-repo

# The subdirectory the pipeline is allowed to touch, relative to TARGET_REPO.
# This is a hard scope guard: a mention about anything else is stopped, not
# widened. Leave empty to allow the whole repo.
TARGET_SCOPE=your_app/

# How the product is referred to in triage ("is this a request about <name>?").
PRODUCT_NAME=Your Product

# The production URL. A Slack message linking here counts as actionable.
PRODUCT_URL=app.example.com


# ─── Linear ──────────────────────────────────────────────────────────────────

# The @Linear bot's Slack member id. The pipeline files tickets by posting a
# one-line command at this bot in the thread, exactly as you would by hand —
# the bot reads the whole conversation, so it writes a better issue than a
# one-shot MCP call. Leave empty to disable bot-filed tickets entirely.
LINEAR_BOT_USER_ID=U00000000000

# Your linear.app workspace slug (from linear.app/<slug>/…).
LINEAR_WORKSPACE=your-workspace

# The parameters of that one-line command. They are near-constants; see the
# "Filing the Linear ticket" section of the README for why each is fixed.
LINEAR_PROJECT=your-project
LINEAR_PRIORITY=mid
LINEAR_STATUS=todo

# The issue-key prefix the project yields (e.g. EXP in EXP-372). Used in branch
# names and PR titles.
LINEAR_ISSUE_PREFIX=ABC


# ─── Who earns a ticket, and who doesn't ─────────────────────────────────────
#
# Comma-separated `Name:MemberID`. Requests from the product side become
# tickets — they report in prose and produce no Linear artifact, so converting
# that is the job. Requests from fellow engineers do not: they file their own,
# and a ticket from the bridge is a duplicate. Both lists may be empty.

SLACK_PRODUCT_TEAM=Alice:U00000000001,Bob:U00000000002
SLACK_ENGINEER_TEAM=Carol:U00000000003,Dave:U00000000004


# ─── Runtime ─────────────────────────────────────────────────────────────────

# Dashboard port. The server binds 127.0.0.1 only.
SLACK_BRIDGE_PORT=4319

# launchd job label, and the filename installed into ~/Library/LaunchAgents/.
# Reverse-DNS by convention; must be unique on the machine.
LAUNCHD_LABEL=local.slack-bridge

# launchd hands a job `/usr/bin:/bin:/usr/sbin:/sbin` and nothing else. These
# are prepended so `claude` and `uvx` (which mcp-modal is spawned through) are
# findable. Defaults to $HOME/.local/bin:/opt/homebrew/bin — set it only if
# yours live elsewhere. No shell expansion: write absolute paths.
# EXTRA_PATH=/Users/you/.local/bin:/opt/homebrew/bin


# ─── Poller defaults ─────────────────────────────────────────────────────────
#
# Starting values only. config.json is authoritative once it exists, and the
# dashboard's Schedule panel writes it — these seed the first run and act as
# the fallback if config.json is missing or unreadable.

# Seconds between ticks. Every tick costs a full session even when it finds
# nothing, so this is the single biggest cost lever. 300 = 5 min of worst-case
# latency for ~1/5 the spend of 60.
POLL_INTERVAL_SEC=300

# Local 24h window, `HH-HH`. Empty disables the window (polls around the clock).
POLL_ACTIVE_HOURS=08-20

# Days to poll on: 1=Mon .. 7=Sun.
POLL_ACTIVE_DAYS=12345

# Triage is easy classification work, so ticks run cheap...
SCAN_MODEL=haiku

# ...and the dispatched pipeline — which writes and ships code — is escalated.
PIPELINE_MODEL=opus
